                ]
              }
            },
            {
              "id": "leave",
              "text": "We will look around.",
              "endsConversation": true,
              "consequence": {
                "setFlags": [
                  "flag.fixture.spoken"
                ]
              }
            }
          ]
        },
        {
          "id": "explain",
          "text": "A small content test. Its room, people, supplies and objectives came from the campaign JSON file.",
          "choices": [
